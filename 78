#include <iostream>
#include <cmath>
using namespace std;

int isSquare(int n) {
    if (n < 0) return 0;
    
    int sqrtN = sqrt(n);
    if (sqrtN * sqrtN == n) {
        return sqrtN;
    }
    return 0;
}

int main() {
    int num;
    cout << "Enter a number: ";
    cin >> num;
    
    int result = isSquare(num);
    if (result != 0) {
        cout << num << " is square (" << result << "^2)" << endl;
    } else {
        cout << num << " is NOT square" << endl;
    }
    return 0;
}
