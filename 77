#include <iostream>
using namespace std;

float average(float x1, float x2 = 0, float x3 = 0, float x4 = 0) {
    int count = 1;
    float sum = x1;
    if (x2 != 0) { sum += x2; count++; }
    if (x3 != 0) { sum += x3; count++; }
    if (x4 != 0) { sum += x4; count++; }
    return sum / count;
}

int main() {
    cout << "Avg of 2, 4 = " << average(2, 4) << endl;
    cout << "Avg of 1, 3, 5 = " << average(1, 3, 5) << endl;
    cout << "Avg of 2, 4, 6, 8 = " << average(2, 4, 6, 8) << endl;
    cout << "Avg of 10 = " << average(10) << endl;
    return 0;
}
