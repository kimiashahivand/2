#include <iostream>
using namespace std;

long long fact(int n) {
    long long result = 1;
    for (int i = 2; i <= n; i++)
        result *= i;
    return result;
}

long long C1(int n, int k) {
    if (k > n) return 0;
    if (k == 0 || k == n) return 1;
    return fact(n) / (fact(k) * fact(n - k));
}

int main() {
    int n, k;
    cout << "Enter n and k: ";
    cin >> n >> k;
    cout << "C(" << n << "," << k << ") = " << C1(n, k) << endl;
    return 0;
}
