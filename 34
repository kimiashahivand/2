#include <iostream>
using namespace std;

double power(double x, int p) {
    if (p == 0) return 1.0;
    
    double result = 1.0;
    int absP = (p > 0) ? p : -p;
    
    // محاسبه با ضرب متوالی (الگوریتم ساده)
    for (int i = 0; i < absP; i++) {
        result *= x;
    }
    
    // اگر توان منفی باشد، معکوس می‌کنیم
    if (p < 0) {
        result = 1.0 / result;
    }
    
    return result;
}

int main() {
    double x;
    int p;
    cout << "Enter base (x) and exponent (p): ";
    cin >> x >> p;
    cout << x << "^" << p << " = " << power(x, p) << endl;
    return 0;
}
