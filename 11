#include <iostream>
using namespace std;

long long fact(int n) {
    long long result = 1;
    for (int i = 2; i <= n; i++)
        result *= i;
    return result;
}

long long P(int n, int k) {
    if (k > n) return 0;
    long long result = 1;
    for (int i = n; i > n - k; i--)
        result *= i;
    return result;
}

long long C(int n, int k) {
    if (k > n) return 0;
    return P(n, k) / fact(k);
}

int main() {
    int n, k;
    cout << "Enter n and k: ";
    cin >> n >> k;
    cout << "C(" << n << "," << k << ") = " << C(n, k) << endl;
    return 0;
}
