#include <iostream>
using namespace std;

// تابع بزرگ‌ترین مقسوم‌علیه مشترک (از مساله ۱۷)
int gcd(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

// تابع کوچک‌ترین مضرب مشترک
int lcm(int a, int b) {
    return (a * b) / gcd(a, b);
}

int main() {
    int a, b;
    cout << "Enter two positive integers: ";
    cin >> a >> b;
    cout << "LCM(" << a << "," << b << ") = " << lcm(a, b) << endl;
    return 0;
}
